# Anthropic / Claude Agent SDK
ANTHROPIC_API_KEY=

# GitHub App auth (production path — see src/tools/github_auth.py)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=./.secrets/github-app.pem
GITHUB_APP_INSTALLATION_ID=
GITHUB_WEBHOOK_SECRET=

# Local-dev-only auth path (never used once the GitHub App is wired up)
GITHUB_PAT=

# Which repo the agent is watching, e.g. suhaani-agarwal/kyctrl-demo-target
TARGET_REPO=

# Path to the policy config the agent reads at the start of every run
AI_MAINTAINER_CONFIG_PATH=.github/ai-maintainer.yaml

# Local dashboard/API port
PORT=8000

# Audit log SQLite path (read by src/runtime.py; defaults to ./audit.sqlite3
# if unset — documented here since it was previously undocumented)
AUDIT_DB_PATH=audit.sqlite3

# Slack — Slack Bolt app (events adapter + AI Assistant surface). Leave
# blank to keep qa_assistant/security_agent's Slack posting disabled; every
# Slack call degrades to a no-op (logged) without these set.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Neo4j — shared graph store for the Q&A assistant's LightRAG doc index
# (see docker-compose.yml's `neo4j` service; NEO4J_PASSWORD has no default
# and docker-compose will refuse to start the neo4j service without it).
# NEO4J_USERNAME (not NEO4J_USER) — LightRAG's Neo4JStorage backend reads
# this exact name directly from the environment.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# LLM/embeddings for the doc-graph indexing pipeline (scripts/build_doc_index.py)
# and retrieval (tools/doc_retriever.py). Anthropic has no embeddings
# endpoint of its own, so embeddings go through Voyage AI — Anthropic's
# recommended embedding partner, and already a first-class provider in
# lightrag-hku (lightrag.llm.voyageai). ANTHROPIC_API_KEY above is reused
# for LightRAG's own LLM calls (entity extraction, tracking-issue-style
# summarization during indexing).
VOYAGE_API_KEY=

# Shared secret for POST /internal/cron/{job} — the ingress GitHub Actions
# `schedule:` workflows call for the Pattern Agent and the doc-index
# refresh (see .github/workflows/*.yaml). Not GitHub-HMAC-signed like
# /webhook, since these aren't GitHub webhook deliveries.
CRON_SECRET=
